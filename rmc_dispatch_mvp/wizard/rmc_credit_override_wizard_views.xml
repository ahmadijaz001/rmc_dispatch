<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rmc_credit_override_wizard_form" model="ir.ui.view">
        <field name="name">rmc.credit.override.wizard.form</field>
        <field name="model">rmc.credit.override.wizard</field>
        <field name="arch" type="xml">
            <form string="Override Credit Block">
                <field name="calloff_id" invisible="1"/>
                <group>
                    <field name="reason" placeholder="Reason for overriding the credit block..."/>
                </group>
                <footer>
                    <button string="Confirm Override" type="object" name="action_confirm" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
