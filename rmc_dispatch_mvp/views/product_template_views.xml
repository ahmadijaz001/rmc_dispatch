<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_rmc" model="ir.ui.view">
        <field name="name">product.template.form.rmc</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="after">
                <page name="rmc_concrete" string="RMC Concrete">
                    <group>
                        <group>
                            <field name="is_rmc_concrete"/>
                            <field name="concrete_grade" invisible="not is_rmc_concrete"/>
                            <field name="target_strength" invisible="not is_rmc_concrete"/>
                            <field name="mix_approval_reference" invisible="not is_rmc_concrete"/>
                            <field name="default_free_unloading_minutes" invisible="not is_rmc_concrete"/>
                        </group>
                        <group>
                            <field name="rmc_material_type"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_rmc_concrete_grade" model="ir.actions.act_window">
        <field name="name">Concrete Grades</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_rmc_concrete', '=', True)]</field>
        <field name="context">{'default_is_rmc_concrete': True, 'default_type': 'consu', 'default_is_storable': False}</field>
    </record>
</odoo>
