<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rmc_return_reason_list" model="ir.ui.view">
        <field name="name">rmc.return.reason.list</field>
        <field name="model">rmc.return.reason</field>
        <field name="arch" type="xml">
            <list string="Return Reasons" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="chargeable"/>
                <field name="default_charge_product_id" invisible="not chargeable"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_rmc_return_reason_form" model="ir.ui.view">
        <field name="name">rmc.return.reason.form</field>
        <field name="model">rmc.return.reason</field>
        <field name="arch" type="xml">
            <form string="Return Reason">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="chargeable"/>
                        <field name="default_charge_product_id" invisible="not chargeable" required="chargeable"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rmc_return_reason" model="ir.actions.act_window">
        <field name="name">Return Reasons</field>
        <field name="res_model">rmc.return.reason</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
