<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rmc_load_margin_report_pivot" model="ir.ui.view">
        <field name="name">rmc.load.margin.report.pivot</field>
        <field name="model">rmc.load.margin.report</field>
        <field name="arch" type="xml">
            <pivot string="Load Margin Analysis">
                <field name="project_id" type="row"/>
                <field name="product_id" type="row"/>
                <field name="sales_value" type="measure"/>
                <field name="standby_revenue" type="measure"/>
                <field name="material_cost" type="measure"/>
                <field name="gross_margin" type="measure"/>
                <field name="margin_pct" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_rmc_load_margin_report_graph" model="ir.ui.view">
        <field name="name">rmc.load.margin.report.graph</field>
        <field name="model">rmc.load.margin.report</field>
        <field name="arch" type="xml">
            <graph string="Load Margin Analysis" type="bar">
                <field name="date" interval="week"/>
                <field name="gross_margin" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_rmc_load_margin_report_list" model="ir.ui.view">
        <field name="name">rmc.load.margin.report.list</field>
        <field name="model">rmc.load.margin.report</field>
        <field name="arch" type="xml">
            <list string="Load Margin Analysis" create="false" edit="false">
                <field name="load_id"/>
                <field name="date"/>
                <field name="customer_id"/>
                <field name="project_id"/>
                <field name="product_id"/>
                <field name="delivered_qty_m3"/>
                <field name="sales_value"/>
                <field name="standby_revenue"/>
                <field name="material_cost"/>
                <field name="gross_margin"/>
                <field name="margin_pct"/>
            </list>
        </field>
    </record>

    <record id="view_rmc_load_margin_report_search" model="ir.ui.view">
        <field name="name">rmc.load.margin.report.search</field>
        <field name="model">rmc.load.margin.report</field>
        <field name="arch" type="xml">
            <search string="Load Margin Analysis">
                <field name="project_id"/>
                <field name="product_id"/>
                <field name="customer_id"/>
                <group>
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Grade" name="group_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Customer" name="group_customer" context="{'group_by': 'customer_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rmc_load_margin_report" model="ir.actions.act_window">
        <field name="name">Load Margin Analysis</field>
        <field name="res_model">rmc.load.margin.report</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_rmc_load_margin_report_search"/>
    </record>
</odoo>
